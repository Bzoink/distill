    {
      "id": "05-geometry",
      "path": "05-geometry.html",
      "gate": true,
      "plan_section": "What we tell the page about layout",
      "exercises": [
        "IntersectionObserver",
        "getBoundingClientRect",
        "offsetHeight",
        "getComputedStyle",
        "scrollTo"
      ],
      "why": "Proves the fiction loads lazy content eagerly, and that it does not also reveal display:none.",
      "assertions": [
        {
          "stage": "dom",
          "selector": "#lazy",
          "expect": "LAZY-OK",
          "browser_expect": "LAZY-NEVER-LOADED",
          "divergence": "A real browser never scrolls, so IntersectionObserver never fires. Our fiction reports everything intersecting, which is precisely how lazy content gets loaded eagerly. The engine must beat the browser here."
        },
        {
          "stage": "dom",
          "selector": "#measured",
          "expect": "MEASURE-OK"
        },
        {
          "stage": "dom",
          "selector": "#style-probe",
          "expect": "HIDDEN-RESPECTED"
        },
        {
          "stage": "dom",
          "selector": "#scroll",
          "expect": "SCROLL-OK"
        },
        {
          "stage": "extract",
          "expect_absent": [
            "HIDDEN-LEAKED"
          ]
        }
      ]
    },
    {
      "id": "06-storage-env",
      "path": "06-storage-env.html",

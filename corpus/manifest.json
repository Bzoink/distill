    {
      "id": "03-settle",
      "path": "03-settle.html",
      "gate": true,
      "plan_section": "Settle policy",
      "exercises": [
        "timers",
        "microtasks",
        "in-flight-requests",
        "self-rescheduling-timer"
      ],
      "why": "Half of the settle policy: what must be waited for. The cap is 03b.",
      "assertions": [
        {
          "stage": "dom",
          "selector": "#settle",
          "expect": "early-50ms"
        },
        {
          "stage": "dom",
          "selector": "#settle",
          "expect": "late-400ms"
        },
        {
          "stage": "dom",
          "selector": "#settle",
          "expect": "microtask"
        },
        {
          "stage": "dom",
          "selector": "#settle",
          "expect": "slow-ok"
        },
        {
          "stage": "dom",
          "selector": "#toolate",
          "expect_absent": [
            "TOOLATE-LEAKED"
          ]
        }
      ]
    },
    {
      "id": "03b-hang",
      "path": "03b-hang.html",
      "gate": true,
      "plan_section": "Settle policy",
      "exercises": [
        "hung-request",
        "never-resolving-promise",
        "settle-cap"
      ],
      "why": "The other half: what must NOT be waited for. A real browser waits forever here, so the reference run is expected to time out. That divergence is the fixture's whole thesis.",
      "browser_expect_timeout": true,
      "assertions": [
        {
          "stage": "dom",
          "selector": "#body",
          "expect": "HANG-BODY-OK"
        },
        {
          "stage": "dom",
          "selector": "#hang",
          "expect_absent": [
            "HANG-RESOLVED-IMPOSSIBLE",

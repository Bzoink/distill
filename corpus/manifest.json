      "exercises": [
        "script-order",
        "defer",
        "async",
        "DOMContentLoaded",
        "load",
        "readystatechange"
      ],
      "why": "Every API here can work individually and still yield nothing, because content hangs off the sequence.",
      "assertions": [
        {
          "stage": "dom",
          "selector": "#order",
          "expect": "head,body,defer-a,defer-b,dcl,load"
        },
        {
          "stage": "dom",
          "selector": "#ready",
          "expect": "READY-OK"
        },
        {
          "stage": "dom",
          "selector": "#async",
          "expect": "ASYNC-OK"
        }
      ]

          "stage": "dom",
          "selector": "#survivor",
          "expect": "CHURN-BODY-OK"
        },
        {
          "stage": "dom",
          "selector": "#churn",
          "expect": "CHURN-OK"
        },
        {
          "stage": "dom",
          "selector": "#identity",
          "expect": "IDENTITY-OK"
        },
        {
          "stage": "dom",
          "selector": "#detached",
          "expect": "DETACHED-OK"
        },
        {
          "stage": "dom",
          "selector": "#observer",
          "expect": "OBSERVER-OK"
        }
      ]
    },
    {
      "id": "08-messy",
      "path": "08-messy.html",
      "gate": true,
      "plan_section": "Step 4c, encoding detection, sanitization, style resolver",
      "exercises": [
        "undeclared-encoding",
        "base-href",
        "url-resolution",
        "dynamic-import",
        "hostile-schemes",
        "form-extraction"
      ],
      "why": "Fills the gap between a 3 KB practice page and a 272 KB newspaper, while still naming its own cause on failure.",
      "assertions": [
        {
          "stage": "dom",
          "selector": "#encoding",
          "expect": "ENCODING-OK"
        },
        {
          "stage": "dom",
          "selector": "#encoding",
          "expect": "å",
          "browser_expect": "Ã¥",
          "divergence": "Chrome falls back to windows-1252 for an undeclared page and produces mojibake; only a BOM saves it. Encoding detection is what Lexbor buys us, and mojibake is never the useful outcome for a reader."
        },
        {
          "stage": "dom",
          "selector": "#resolved",
          "expect": "RESOLVE-OK"
        },
        {
          "stage": "dom",
          "selector": "#imported",
          "expect": "IMPORT-OK"
        },
        {
          "stage": "extract",
          "expect_absent": [
            "NAVLEAK",
            "PROMOLEAK",
            "SUBLEAK",
            "javascript:",
            "XSS-LEAKED"
          ]

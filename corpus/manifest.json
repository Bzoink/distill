        {"stage": "extract", "path": "links", "expect": "/deep/other/page.html"},
        {"stage": "extract", "path": "links", "expect": "mailto:red@example.org"},
        {"stage": "extract", "path": "forms", "expect": "/deep/section/find"},
        {"stage": "extract", "path": "media", "expect": "/deep/section/images/photo.jpg"}

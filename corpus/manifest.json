{
  "note": "The Phase 0 assertion contract. 'dom'-stage assertions are checked against the post-JS DOM at settle time; 'extract'-stage assertions are checked against extractor output and belong to Phase 1. Local pages are gates; live pages never are. Where 'browser_expect' is present, a reference browser deliberately disagrees with us -- run check.py --baseline to validate fixtures against the browser, and without it to test the engine.",
  "settle_cap_ms": 5000,
  "pages": [
    {
      "id": "00-static",
      "path": "00-static.html",
      "gate": true,
      "plan_section": "Minimal computed style",
      "exercises": [
        "fetch",
        "parse",
        "style-resolver"
      ],
      "why": "Control. No scripts at all, so a failure here is never a binding bug.",
      "assertions": [
        {
          "stage": "dom",
          "selector": "#content",
          "expect": "STATIC-BODY-OK"
        },
        {
          "stage": "extract",
          "expect_absent": [
            "NAVLEAK",
            "LEGALLEAK",
            "FOOTLEAK"
          ]
        }
      ]
    },
    {
      "id": "01-sync-dom",
      "path": "01-sync-dom.html",
      "gate": true,
      "plan_section": "DOM ↔ JS",
      "exercises": [
        "createElement",
        "textContent",
        "classList",
        "dataset",
        "innerHTML",
        "querySelector"
      ],
      "why": "The binding floor. Arm A's mechanically-derived checklist has to clear this.",
      "assertions": [
        {
          "stage": "dom",
          "selector": "#content",
          "expect": "SYNC-BODY-OK"
        },
        {
          "stage": "dom",
          "selector": "#spliced",
          "expect": "SPLICE-OK"
        },
        {
          "stage": "dom",
          "selector": "#probe",
          "expect": "DOM-API-OK"
        }
      ]
    },
    {
      "id": "02-lifecycle",
      "path": "02-lifecycle.html",
